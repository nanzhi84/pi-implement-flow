{
  "name": "pi-implement-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "pi": { "extensions": ["./src/extension.ts"] },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-acceptance.mjs",
