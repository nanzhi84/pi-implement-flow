    "test:ticket-faults": "node tests/run-ticket-faults.mjs",
    "test:integration": "node tests/run-integration.mjs",
    "test:repair": "node tests/run-repair.mjs"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
